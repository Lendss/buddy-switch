<?xml version="1.0" encoding="utf-8"?>
<!-- Every text Buddy shows, in Japanese (です/ます). Source of truth: res/values/strings.xml. -->
<resources>
    <string name="service_label">Buddy アシスタント</string>
    <string name="service_description">Buddy のチャットバブルを表示し、このスマートフォンの Buddy 内で動作する Claude Code または Codex が、画面を読み取って、あなたの代わりにタップ、入力、スクロールできるようにします。エージェント自身が Anthropic または OpenAI に送信する内容以外は、スマートフォンの外に出ません。</string>

    <!-- First-run setup guide: top bar and buttons shared by several steps. -->
    <string name="onboarding_skip_setup">スキップ</string>
    <string name="onboarding_skip_title">セットアップガイドをスキップしますか？</string>
    <string name="onboarding_skip_text">セットアップは「設定」からいつでも完了できます。完了するまでチャットは動作しません。</string>
    <string name="onboarding_skip_action">スキップ</string>
    <string name="onboarding_progress">ステップ %1$d/%2$d</string>
    <string name="onboarding_continue">次へ</string>
    <string name="onboarding_stuck">お困りですか？</string>

    <!-- Guide, welcome screen. -->
    <string name="onboarding_welcome_title">Buddy へようこそ</string>
    <string name="onboarding_welcome_text">あなたの代わりにスマートフォンを操作できるチャットバブルです。</string>
    <string name="onboarding_welcome_ask_title">いつもの言葉で頼めます</string>
    <string name="onboarding_welcome_ask_text">「佐藤さんに遅れるって返信して」「カートに牛乳を入れて」など。</string>
    <string name="onboarding_welcome_plan_title">お使いのプランで、API キー不要</string>
    <string name="onboarding_welcome_plan_text">Claude のサブスクリプションで Claude Code が動きます。ChatGPT のプランで Codex も使えます。</string>
    <string name="onboarding_welcome_control_title">主導権はいつもあなたに</string>
    <string name="onboarding_welcome_control_text">送信、投稿、購入、削除の前には必ず確認します。</string>
    <string name="onboarding_welcome_time">セットアップは約 5 分で完了します</string>
    <string name="onboarding_get_started">始める</string>

    <!-- Guide, step: choose the agent. Agent names next to each option stay in English. -->
    <string name="onboarding_brain_title">エージェントを選択</string>
    <string name="onboarding_brain_text">チャットに応答するエージェントを選びます。ほかのエージェントは後から「設定」で追加できます。</string>
    <string name="onboarding_brain_claude">Claude のサブスクリプション（Pro または Max）を使用します。</string>
    <string name="onboarding_brain_codex">ChatGPT のプランを使用します。</string>
    <string name="onboarding_brain_opencode">無料モデルをアカウントなしで使えます。お使いのプロバイダーは後から接続できます。</string>
    <string name="onboarding_brain_both">両方をインストールして、チャットごとに選べます。デフォルトは Claude Code です。</string>
    <string name="onboarding_recommended">おすすめ</string>

    <!-- Guide, step: turn on Buddy's accessibility service. -->
    <string name="onboarding_access_title">Buddy に画面の操作を許可</string>
    <string name="onboarding_access_done">ユーザー補助がオンになっています。</string>
    <string name="onboarding_access_text">Buddy のユーザー補助サービスはバブルを表示し、あなたが何かを頼んだときだけ、エージェントが画面を読み取ってタップや入力をできるようにします。</string>
    <string name="onboarding_access_privacy">%1$s が応答のために %2$s に送信する内容以外は、スマートフォンの外に出ません。送信、投稿、購入、削除の前には必ず承認を求めます。</string>
    <string name="onboarding_access_privacy_both">Claude Code と Codex が応答のために Anthropic と OpenAI に送信する内容以外は、スマートフォンの外に出ません。送信、投稿、購入、削除の前には必ず承認を求めます。</string>
    <string name="onboarding_access_privacy_opencode">%1$s が応答のためにモデルのプロバイダーに送信する内容以外は、スマートフォンの外に出ません。送信、投稿、購入、削除の前には必ず承認を求めます。</string>
    <string name="onboarding_access_list_hint">一覧で「ダウンロードしたアプリ」→「Buddy アシスタント」を開き、オンにします。</string>
    <string name="onboarding_access_open">ユーザー補助の設定を開く</string>
    <string name="onboarding_access_greyed_title">スイッチがグレー表示ですか？</string>
    <string name="onboarding_access_greyed_text">Android では、ファイルからインストールしたアプリに対してこの設定がブロックされます。下の「アプリ情報」をタップし、右上の ⋮ →「制限付き設定を許可」をタップしてから、もう一度お試しください。</string>
    <string name="onboarding_access_restricted_steps">1. 下の「アプリ情報」をタップします。\n2. 右上の ⋮ →「制限付き設定を許可」をタップします。\n3. 戻って、もう一度ユーザー補助の設定を開きます。</string>
    <string name="onboarding_app_info">アプリ情報</string>

    <!-- Guide, step: install the agent inside Buddy and sign in. -->
    <string name="onboarding_agent_names_both">Claude Code と Codex</string>
    <!-- Agent card status lines: small lowercase mono text, one line. -->
    <string name="onboarding_agent_free_models">無料モデル</string>
    <string name="onboarding_agent_signed_in">ログイン済み</string>
    <string name="onboarding_agent_signed_in_as">ログイン済み · %1$s</string>

    <!-- Guide, step: let Buddy run in the background (Android's battery optimization). -->
    <string name="onboarding_background_title">バックグラウンドで実行</string>
    <string name="onboarding_background_done">Buddy はバックグラウンドで実行できます。</string>
    <string name="onboarding_background_text">エージェントの作業中に、電池を節約するためにスマートフォンが Buddy を停止しないようにします。</string>
    <string name="onboarding_allow">許可</string>
    <string name="onboarding_skip_for_now">今はスキップ</string>

    <!-- Guide, step: how much the agent asks before acting. -->
    <string name="onboarding_safety_title">どこまで確認しますか？</string>
    <string name="onboarding_safety_text">メッセージ、SNS、ショッピング、決済、銀行のアプリでは、Buddy が送信、投稿、購入、削除をする前に必ず承認が必要です。その他のアプリでは：</string>
    <string name="onboarding_safety_ask_title">先に確認する</string>
    <string name="onboarding_safety_ask_text">設定の変更など、リスクのある操作の前にエージェントが確認します。より安全ですが、ポップアップが増えます。</string>
    <string name="onboarding_safety_auto_title">自動で進める</string>
    <string name="onboarding_safety_auto_text">ポップアップなし：カメラや照明をオンにするなど、頼んだことをエージェントがそのまま実行します。</string>
    <string name="onboarding_safety_note">アプリごとにいつでも変更できます（設定 → アプリの権限）。アプリを「信頼」にするとエージェントがポップアップなしで操作し、「厳格」にすると Buddy 自身があなたに確認します。</string>

    <!-- Guide, last step: try a first task. -->
    <string name="onboarding_try_title">準備ができました</string>
    <string name="onboarding_try_text">最初のタスクを試してみましょう。Buddy が設定アプリを開いて、代わりに確認します。</string>
    <string name="onboarding_try_prompt">設定を開いて、Android のバージョンを教えて</string>
    <string name="onboarding_try_prompt_quoted">「%1$s」</string>
    <string name="onboarding_try_tip">ヒント：バブルは他のアプリの上に表示されます。✕ までドラッグすると非表示になります。</string>
    <string name="onboarding_try_now">今すぐ試す</string>
    <string name="onboarding_go_to_chats">チャット一覧へ</string>

