<?xml version="1.0" encoding="utf-8"?>
<!-- Every text Buddy shows, in Korean (해요체). Source of truth: res/values/strings.xml. -->
<resources>
    <string name="service_label">Buddy 어시스턴트</string>
    <string name="service_description">Buddy 채팅 버블을 표시하고, 이 휴대전화의 Buddy 안에서 실행되는 Claude Code 또는 Codex가 화면을 읽고 대신 탭, 입력, 스크롤할 수 있게 해요. 에이전트가 직접 Anthropic 또는 OpenAI로 보내는 내용 외에는 아무것도 휴대전화 밖으로 나가지 않아요.</string>

    <!-- First-run setup guide: top bar and buttons shared by several steps. -->
    <string name="onboarding_skip_setup">건너뛰기</string>
    <string name="onboarding_skip_title">초기 설정 가이드를 건너뛸까요?</string>
    <string name="onboarding_skip_text">초기 설정은 언제든지 ‘설정’ 탭에서 마칠 수 있어요. 마치기 전에는 채팅이 실행되지 않아요.</string>
    <string name="onboarding_skip_action">건너뛰기</string>
    <string name="onboarding_progress">%1$d/%2$d단계</string>
    <string name="onboarding_continue">다음</string>
    <string name="onboarding_stuck">잘 안 되나요?</string>

    <!-- Guide, welcome screen. -->
    <string name="onboarding_welcome_title">Buddy를 만나 보세요</string>
    <string name="onboarding_welcome_text">휴대전화를 대신 사용해 주는 채팅 버블이에요.</string>
    <string name="onboarding_welcome_ask_title">평소 말투로 부탁하세요</string>
    <string name="onboarding_welcome_ask_text">“민수에게 늦는다고 답장해 줘”, “장바구니에 우유 담아 줘”처럼요.</string>
    <string name="onboarding_welcome_plan_title">API 키 없이 내 플랜으로</string>
    <string name="onboarding_welcome_plan_text">Claude 구독으로 Claude Code를 실행해요. ChatGPT 플랜이 있으면 Codex도 쓸 수 있어요.</string>
    <string name="onboarding_welcome_control_title">언제나 직접 결정해요</string>
    <string name="onboarding_welcome_control_text">보내기, 게시, 구매, 삭제는 항상 먼저 물어봐요.</string>
    <string name="onboarding_welcome_time">초기 설정은 5분 정도 걸려요</string>
    <string name="onboarding_get_started">시작하기</string>

    <!-- Guide, step: choose the agent. Agent names next to each option stay in English. -->
    <string name="onboarding_brain_title">에이전트를 고르세요</string>
    <string name="onboarding_brain_text">채팅에 답할 에이전트예요. 다른 에이전트는 나중에 ‘설정’에서 추가할 수 있어요.</string>
    <string name="onboarding_brain_claude">Claude 구독(Pro 또는 Max)을 사용해요.</string>
    <string name="onboarding_brain_codex">ChatGPT 플랜을 사용해요.</string>
    <string name="onboarding_brain_opencode">무료 모델을 쓸 수 있고 계정이 필요 없어요. 원하는 제공업체는 나중에 연결하세요.</string>
    <string name="onboarding_brain_both">둘 다 설치하고 채팅마다 골라요. 기본값은 Claude Code예요.</string>
    <string name="onboarding_recommended">추천</string>

    <!-- Guide, step: turn on Buddy's accessibility service. -->
    <string name="onboarding_access_title">Buddy가 보고 탭할 수 있게 하기</string>
    <string name="onboarding_access_done">접근성이 켜져 있어요.</string>
    <string name="onboarding_access_text">Buddy의 접근성 서비스는 버블을 표시하고, 무언가를 요청했을 때만 에이전트가 화면을 읽고 탭하고 입력할 수 있게 해요.</string>
    <string name="onboarding_access_privacy">%1$s가 답하기 위해 %2$s에 보내는 내용 외에는 아무것도 휴대전화 밖으로 나가지 않아요. 보내기, 게시, 구매, 삭제는 항상 먼저 승인을 요청해요.</string>
    <string name="onboarding_access_privacy_both">Claude Code와 Codex가 답하기 위해 Anthropic과 OpenAI에 보내는 내용 외에는 아무것도 휴대전화 밖으로 나가지 않아요. 보내기, 게시, 구매, 삭제는 항상 먼저 승인을 요청해요.</string>
    <string name="onboarding_access_privacy_opencode">%1$s가 답하기 위해 모델 제공업체에 보내는 내용 외에는 아무것도 휴대전화 밖으로 나가지 않아요. 보내기, 게시, 구매, 삭제는 항상 먼저 승인을 요청해요.</string>
    <string name="onboarding_access_list_hint">목록에서 ‘다운로드한 앱’(또는 ‘설치된 앱’) → ‘Buddy 어시스턴트’로 이동해 켜세요.</string>
    <string name="onboarding_access_open">접근성 설정 열기</string>
    <string name="onboarding_access_greyed_title">스위치가 회색인가요?</string>
    <string name="onboarding_access_greyed_text">Android는 파일로 설치한 앱에서 이 설정을 차단해요. 아래의 ‘앱 정보’를 탭한 다음 오른쪽 위 ⋮ → ‘제한된 설정 허용’을 탭하고 다시 시도하세요.</string>
    <string name="onboarding_access_restricted_steps">1. 아래의 ‘앱 정보’를 탭하세요.\n2. 오른쪽 위 ⋮ → ‘제한된 설정 허용’을 탭하세요.\n3. 돌아와서 접근성 설정을 다시 여세요.</string>
    <string name="onboarding_app_info">앱 정보</string>

    <!-- Guide, step: install the agent inside Buddy and sign in. -->
    <string name="onboarding_agent_names_both">Claude Code와 Codex</string>
    <!-- Agent card status lines: small lowercase mono text, one line. -->
    <string name="onboarding_agent_free_models">무료 모델</string>
    <string name="onboarding_agent_signed_in">로그인됨</string>
    <string name="onboarding_agent_signed_in_as">로그인됨 · %1$s</string>

    <!-- Guide, step: let Buddy run in the background (Android's battery optimization). -->
    <string name="onboarding_background_title">계속 실행되게 하기</string>
    <string name="onboarding_background_done">Buddy가 백그라운드에서 실행될 수 있어요.</string>
    <string name="onboarding_background_text">에이전트가 작업하는 동안 휴대전화가 배터리를 아끼려고 Buddy를 멈추지 않게 해요.</string>
    <string name="onboarding_allow">허용</string>
    <string name="onboarding_skip_for_now">나중에 하기</string>

    <!-- Guide, step: how much the agent asks before acting. -->
    <string name="onboarding_safety_title">얼마나 물어볼까요?</string>
    <string name="onboarding_safety_text">메시지, 소셜, 쇼핑, 결제, 은행 앱에서는 Buddy가 보내기, 게시, 구매, 삭제를 하기 전에 항상 승인이 필요해요. 그 외 앱에서는:</string>
    <string name="onboarding_safety_ask_title">먼저 물어보기</string>
    <string name="onboarding_safety_ask_text">설정 변경처럼 위험할 수 있는 작업 전에 에이전트가 물어봐요. 더 안전하지만 팝업이 많아져요.</string>
    <string name="onboarding_safety_auto_title">알아서 하기</string>
    <string name="onboarding_safety_auto_text">팝업 없이, 카메라나 조명 켜기처럼 요청한 일을 에이전트가 바로 해요.</string>
    <string name="onboarding_safety_note">앱별로 언제든지 바꿀 수 있어요(설정 → 앱 권한). 앱을 ‘신뢰’로 설정하면 에이전트가 팝업 없이 작업하고, ‘엄격’으로 설정하면 Buddy가 직접 물어봐요.</string>

    <!-- Guide, last step: try a first task. -->
    <string name="onboarding_try_title">준비가 끝났어요</string>
    <string name="onboarding_try_text">첫 작업을 해 보세요. Buddy가 설정 앱을 열고 대신 읽어 줄 거예요.</string>
    <string name="onboarding_try_prompt">설정 열고 내 Android 버전 알려 줘</string>
    <string name="onboarding_try_prompt_quoted">“%1$s”</string>
    <string name="onboarding_try_tip">팁: 버블은 다른 앱 위에 떠 있어요. ✕로 끌어다 놓으면 숨길 수 있어요.</string>
    <string name="onboarding_try_now">지금 해 보기</string>
    <string name="onboarding_go_to_chats">내 채팅으로 이동</string>

