#!/bin/bash
# Run by the Buddy app in Termux (this fork: Buddy for Switch), through Termux's RUN_COMMAND service, as
#   bash -c <this script> buddy-run <token> …
# with the app's instructions in front of it: $BUDDY_SYSTEM (the system prompt) and $BUDDY_PERMS (App permissions).
#   buddy-run <token> ask <session> <claude|codex|opencode> <dev:0|1|rule> <message> [model] [attachment-ids]
#     (rule: a notification rule's run, working for someone else's message: no shell, files or web tools)
#                                    run the agent on the message in that session, streaming events to the bubble
#   buddy-run <token> stop <session>       stop that session's running request
#   buddy-run <token> note <session> <text>   something the user added while it works: the agent gets it after its
#                                    current step (a PostToolUse hook, see run_claude)
#   buddy-run <token> delete <session>     forget that session
#   buddy-run <token> ping                 answer the app's setup check
#   buddy-run <token> procs                list running Claude Code / Codex processes (buddy_procs)
#   buddy-run <token> kill <pid>           stop a running Claude Code / Codex process and its children
#   buddy-run <token> recent               list recent Claude Code / Codex sessions from their history (buddy_recent)
#   buddy-run <token> transcript <claude|codex> <file>   last messages of a session (buddy_transcript)
#   buddy-run <token> adopt <session> <claude|codex> <agent-session-id>  continue that session as a Buddy chat
#   buddy-run <token> remote <session> <dev:0|1> <name> [model]   keep that chat open with Remote Control (an interactive
#                                    Claude Code, for claude.ai/code and the Claude app) until remote-stop; its turns are
#                                    mirrored to the bubble
#   buddy-run <token> remote-say <session> <message> [attachment-ids]   type a message into that chat's remote session
#   buddy-run <token> remote-key <session> esc          press a key there (esc: interrupt the turn)
#   buddy-run <token> remote-stop <session>             end that chat's remote session
#   buddy-run <token> remote-status                     report the chats that have a remote session (buddy_remote)
# Every event sent to the bubble carries "buddy_session" so the app can route it.
HELPER_VERSION=13
set -u
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
# Termux's own commands first: its claude is a launcher script in $PREFIX/bin
export PATH=$PREFIX/bin:$HOME/.local/bin:$HOME/bin:$PATH
# The claude launcher sets BUN_OPTIONS with a path relative to its folder; never inherit a stale one.
unset BUN_OPTIONS
D=$HOME/.buddy
# The agent works in the home folder, like Claude Code started in the Termux terminal: same project, memory and CLAUDE.md
W=$HOME
mkdir -p "$W" "$D/sessions"
TOKEN=${1:-}
CMD=${2:-}
URL=http://127.0.0.1:8775   # this fork's port (McpServer.PORT)

post() { # post one JSON event to the bubble
  curl -s -m 5 -o /dev/null -X POST -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: application/json' --data-binary @- "$URL/event"
}
have() { command -v "$1" >/dev/null 2>&1; }
valid_sid() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,64}$ ]]; }
# OpenCode 2 (npm @opencode/cli) rather than 1.x (opencode-ai)? 2 needs --standalone, or it leaves a background service
oc2() { [[ "$(readlink -f "$(command -v opencode)" 2>/dev/null)" == */@opencode/cli/* ]]; }

# Attachments: fetch them from the app (comma-separated ids, $FILES) into the session's files folder ($S/files),
# and add a note to $MSG saying where they are. Images are listed in IMGS too.
ATT=()
IMGS=()
fetch_attachments() {
  [ -n "${FILES:-}" ] || return 0
  mkdir -p "$S/files"
  local ids id
  IFS=, read -ra ids <<< "$FILES"
  for id in "${ids[@]}"; do
    [[ "$id" =~ ^[A-Za-z0-9._-]{1,120}$ && "$id" != *..* ]] || continue
    if curl -s -f -m 120 -H "Authorization: Bearer $TOKEN" "$URL/file/$id" -o "$S/files/$id"; then
      ATT+=("$S/files/$id")
      case "${id,,}" in *.jpg|*.jpeg|*.png|*.webp|*.gif) IMGS+=("$S/files/$id") ;; esac
    else
      event buddy_error "Couldn't get the attachment ${id#*_} from Buddy."
    fi
  done
  if [ ${#ATT[@]} -gt 0 ]; then
    MSG="$MSG

[The user attached $( [ ${#ATT[@]} -eq 1 ] && echo "a file" || echo "${#ATT[@]} files" ), saved on this phone. Open them with your Read tool (images show as pictures):
$(printf -- '- %s\n' "${ATT[@]}")]"
  fi
}
event() { jq -cn --arg type "$1" --arg text "${2:-}" --arg s "$SID" '{type:$type,text:$text,buddy_session:$s}' | post; }

# Pictures in a reply (one event on stdin, printed back): a full path in its text (/… or ~/…, outside code blocks) to
# a .png/.jpg/.webp/.gif that exists is copied into Buddy (PUT /file/<id>), and the event gets
# buddy_images [{ref: the path as written, id}], so the chat shows the picture with the reply.
PIC_RE='(~|/)[^][[:space:]`"'"'"'<>()*|]*\.(png|jpe?g|webp|gif)'
images() {
  local ev ref p name id list="[]"
  ev=$(cat)
  # most events are no reply, or one without a picture
  if [[ "$ev" != *'"type":"assistant"'* ]] || ! grep -qiE '\.(png|jpe?g|webp|gif)' <<< "$ev"; then
    printf '%s' "$ev"
    return
  fi
  while IFS= read -r ref; do
    p=$ref
    [[ "$p" == "~/"* ]] && p=$HOME/${p#\~/}
    [ -f "$p" ] && [ -r "$p" ] && [ "$(stat -c %s "$p")" -le 26214400 ] || continue
    name=$(printf '%s' "${p##*/}" | tr -c 'A-Za-z0-9._-' '_' | tail -c 60)
    id=$(printf '%04x%04x' $RANDOM $RANDOM)_${name//../__}   # an attachment id (Attachments.validId)
    curl -s -f -m 60 -o /dev/null -X PUT -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/octet-stream' \
      -H 'Expect:' --data-binary @"$p" "$URL/file/$id" || continue   # Expect: no waiting for a 100 Continue
    list=$(jq -c --arg r "$ref" --arg i "$id" '. + [{ref:$r, id:$i}]' <<< "$list")
  done < <(printf '%s' "$ev" | jq -r '[.message.content[]? | select(.type == "text") | .text] | join("\n")' 2>/dev/null \
    | awk '/^[[:space:]]*```/ { code = !code; next } !code' | grep -oiE "$PIC_RE" | awk '!seen[$0]++' | head -n 8)
  if [ "$list" = "[]" ]; then printf '%s' "$ev"
  else printf '%s' "$ev" | jq -c --argjson i "$list" '. + {buddy_images: $i}'; fi
}

# Kill a process and everything it started (claude/codex run a few levels below buddy-run).
kill_tree() {
  local p=$1 c
  for c in $(pgrep -P "$p" 2>/dev/null); do kill_tree "$c"; done
  kill -TERM "$p" 2>/dev/null
}

descendants() { # print a pid and all its descendants
  local p=$1 c
  echo "$p"
  for c in $(pgrep -P "$p" 2>/dev/null); do descendants "$c"; done
}


# Is this pid an agent process (the real claude / codex program)?
agent_of() {
  local cmd
  cmd=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) || return 1
  # Termux's Claude Code: glibc's loader runs the real program, .../claude-native/<version>/claude
  case "$cmd" in */ld-linux-*" "*/claude-native/*/claude|*/ld-linux-*" "*/claude-native/*/claude" "*) echo claude; return 0 ;; esac
  case "${cmd%% *}" in
    */claude/versions/*) echo claude ;;
    */codex-linux-*/*|*/bin/codex) echo codex ;;
    */opencode-ai/*|*/@opencode/cli*/*|*/bin/opencode) echo opencode ;;
    *) return 1 ;;
  esac
}

case "$CMD" in
  ping) # setup check: proves RUN_COMMAND, the helper and the callback all work
    agents=$({ have claude && echo claude; have codex && echo codex; have opencode && echo opencode; } | paste -sd, -)
    # signed in = the agent's saved login exists (OpenCode works without one: its free models)
    signed=$({ [ -s "$HOME/.claude/.credentials.json" ] && echo claude; [ -s "$HOME/.codex/auth.json" ] && echo codex
      have opencode && echo opencode; } | paste -sd, -)
    cm=$(jq -c '[.models[] | select(.visibility == "list") | [.slug, .display_name]]' "$HOME/.codex/models_cache.json" 2>/dev/null)
    # OpenCode's model list (a second or two; a background refresh got killed when the helper exited, so the list
    # never updated and new free models didn't show). On failure the last good list is kept.
    have opencode && timeout 30 opencode models $(oc2 && echo --standalone) >"$D/opencode-models.new" 2>/dev/null \
      && [ -s "$D/opencode-models.new" ] && mv "$D/opencode-models.new" "$D/opencode-models"
    om=$(jq -Rsc 'split("\n") | map(select(test("^[A-Za-z0-9._-]+/\\S+$"))) | map([., (split("/") | .[1:] | join("/"))])' "$D/opencode-models" 2>/dev/null)
    jq -cn --arg s "${agents:-none}" --arg g "${signed:-none}" --argjson v "$HELPER_VERSION" --argjson cm "${cm:-[]}" \
      --argjson om "${om:-[]}" '{type:"buddy_pong",text:$s,signed:$g,helper:$v,codex_models:$cm,opencode_models:$om}' | post
    exit 0 ;;
  procs)
    # map every process started by a Buddy chat to that chat
    declare -A owner=()
    for f in "$D"/sessions/*/pid; do
      [ -f "$f" ] || continue
      sid=$(basename "$(dirname "$f")")
      for q in $(descendants "$(cat "$f")"); do owner[$q]=$sid; done
    done
    {
      for p in $(pgrep -f 'claude-native/|claude/versions/|codex-linux-|/bin/codex|opencode-ai/|@opencode/cli|/bin/opencode' 2>/dev/null); do
        a=$(agent_of "$p") || continue
        [ "$p" = "$$" ] && continue
        cwd=$(readlink "/proc/$p/cwd" 2>/dev/null)
        et=$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ')
        args=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | cut -c1-300)
        # what kind of process: Claude Code's background service, a session it hosts, or a terminal session
        pargs=$(tr '\0' ' ' < "/proc/$(ps -o ppid= -p "$p" | tr -d ' ')/cmdline" 2>/dev/null)
        kind=terminal
        case "$args" in *" daemon run"*) kind=daemon ;; esac
        [ "$kind" = terminal ] && case "$pargs" in *bg-pty-host*) kind=background ;; esac
        # its conversation: --session-id wins (a fork gets a new id), else --resume <id>
        ses=$(printf '%s' "$args" | grep -oE -- '--session-id [0-9a-f-]{36}' | head -1 | cut -d' ' -f2)
        [ -z "$ses" ] && ses=$(printf '%s' "$args" | grep -oE -- '--resume [0-9a-f-]{36}' | head -1 | cut -d' ' -f2)
        title=""
        if [ -n "$ses" ] && [ "$a" = claude ]; then
          f=$(ls "$HOME"/.claude/projects/*/"$ses".jsonl 2>/dev/null | head -1)
          [ -n "$f" ] && title=$(head -n 400 "$f" | jq -r 'select(.type=="user") | .message.content
            | if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end
            | select(. != "" and (startswith("<") | not) and (startswith("This session is being continued") | not)
                and (startswith("Caveat:") | not))' 2>/dev/null | head -1 | tr '\n' ' ' | cut -c1-80)
        fi
        jq -cn --argjson pid "$p" --arg agent "$a" --arg cwd "$cwd" --arg et "${et:-0}" \
          --arg args "$args" --arg buddy "${owner[$p]:-}" --arg kind "$kind" --arg ses "$ses" --arg title "$title" \
          '{pid:$pid, agent:$agent, cwd:$cwd, seconds:($et|tonumber), args:$args, buddy:$buddy,
            kind:$kind, session:$ses, title:$title}'
      done
    } | jq -cs '{type:"buddy_procs", procs:.}' | post
    exit 0 ;;
  kill)
    P=${3:-}
    [[ "$P" =~ ^[0-9]+$ ]] && agent_of "$P" >/dev/null || exit 2   # only ever kill claude/codex/opencode
    kill_tree "$P"
    exit 0 ;;
  recent)
    {
      # skip the Remote Control session's folder (RemoteSession.DIR): it must not be adopted while it runs
      for f in $(ls -t "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | grep -v '/-root-remote/' | head -15); do
        head -n 300 "$f" | jq -c --arg f "$f" --arg m "$(stat -c %Y "$f")" -s '
          ([.[] | select(.type=="user") | .message.content
                | if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end
                | select(. != "" and (startswith("<")|not) and (startswith("This session is being continued")|not)
                    and (startswith("Caveat:")|not))] | first // "") as $t
          | {agent:"claude", file:$f, id:($f|split("/")|last|rtrimstr(".jsonl")),
             cwd:([.[]|.cwd//empty]|first//""), title:($t|.[0:120]), mtime:($m|tonumber)}' 2>/dev/null
      done
      for f in $(find "$HOME/.codex/sessions" -name '*.jsonl' 2>/dev/null | xargs -r ls -t 2>/dev/null | head -15); do
        head -n 80 "$f" | jq -c --arg f "$f" --arg m "$(stat -c %Y "$f")" -s '
          ([.[] | select(.type=="session_meta") | .payload] | first // {}) as $meta
          | ([.[] | select(.type=="response_item" and .payload.type=="message" and .payload.role=="user")
                | .payload.content[]? | .text // empty
                | select(startswith("<")|not)
                | (if contains("User message from the Buddy bubble:\n") then split("User message from the Buddy bubble:\n")|last else . end)]
             | last // "") as $t
          | {agent:"codex", file:$f, id:($meta.id//""), cwd:($meta.cwd//""), title:($t|.[0:120]),
             mtime:($m|tonumber)}' 2>/dev/null
      done
    } | jq -cs --argjson own "$(for f in "$D"/sessions/*/claude-session "$D"/sessions/*/codex-thread; do
          [ -f "$f" ] && jq -cn --arg k "$(cat "$f")" --arg v "$(basename "$(dirname "$f")")" '{($k):$v}'
        done | jq -cs 'add // {}')" \
      '{type:"buddy_recent", sessions:(sort_by(-.mtime)|.[0:25]|map(. + {buddy:($own[.id] // "")}))}' | post
    exit 0 ;;
  transcript)
    A=${3:-}; F=${4:-}
    case "$F" in "$HOME"/.claude/projects/*.jsonl|"$HOME"/.codex/sessions/*.jsonl) ;; *) exit 2 ;; esac
    [ -f "$F" ] || exit 2
    if [ "$A" = claude ]; then
      tail -n 600 "$F" | jq -c 'select(.type=="user" or .type=="assistant")
        | {role:.message.role, text:(if (.message.content|type)=="string" then .message.content
            else ([.message.content[]? | select(.type=="text") | .text] | join("\n")) end)}
        | select(.text != "" and (.text|startswith("<")|not))' 2>/dev/null
    else
      tail -n 600 "$F" | jq -c 'select(.type=="response_item" and .payload.type=="message"
          and (.payload.role=="user" or .payload.role=="assistant"))
        | {role:.payload.role, text:([.payload.content[]? | .text // empty] | join("\n"))}
        | select(.text != "" and (.text|startswith("<")|not))' 2>/dev/null
    fi | tail -n 40 | jq -cs --arg f "$F" '{type:"buddy_transcript", file:$f, messages:map(.text |= .[0:2000])}' | post
    exit 0 ;;
  adopt)
    SID=${3:-}; A=${4:-}; AID=${5:-}
    valid_sid "$SID" && [[ "$AID" =~ ^[A-Za-z0-9-]{8,64}$ ]] || exit 2
    mkdir -p "$D/sessions/$SID"
    if [ "$A" = codex ]; then printf '%s' "$AID" > "$D/sessions/$SID/codex-thread"
    else printf '%s' "$AID" > "$D/sessions/$SID/claude-session"; fi
    exit 0 ;;
  stop)
    SID=${3:-}; valid_sid "$SID" || exit 2
    P=$D/sessions/$SID/pid
    if [ -f "$P" ]; then
      kill_tree "$(cat "$P")"
      rm -f "$P"
      jq -cn --arg s "$SID" '{type:"buddy_stopped",buddy_session:$s}' | post
    fi
    exit 0 ;;
  delete)
    SID=${3:-}; valid_sid "$SID" || exit 2
    S=$D/sessions/$SID
    [ -f "$S/pid" ] && kill_tree "$(cat "$S/pid")"
    [ -f "$S/remote.pid" ] && kill_tree "$(cat "$S/remote.pid")"
    rm -rf "${S:?}"
    exit 0 ;;
  note)
    SID=${3:-}; valid_sid "$SID" || exit 2
    [ -f "$D/sessions/$SID/pid" ] && printf '%s\n' "${4:-}" >> "$D/sessions/$SID/notes"
    exit 0 ;;
  remote-say|remote-key)
    SID=${3:-}; valid_sid "$SID" || exit 2
    F=$D/sessions/$SID/remote.in
    [ -p "$F" ] || exit 0
    if [ "$CMD" = remote-key ]; then
      [ "${4:-}" = esc ] && printf '\e' > "$F"
    else
      MSG=${4:-}; FILES=${5:-}; S=$D/sessions/$SID
      reply() { # a reply in the chat without a turn of the remote session
        jq -cn --arg t "$1" --arg s "$SID" '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
        jq -cn --arg s "$SID" '{type:"buddy_done", buddy_session:$s}' | post
      }
      # The interactive session shows these in a screen of its own, which Buddy can't read: a separate run over the
      # same conversation answers them in Markdown, as without Remote, and saves nothing to it.
      if [[ "$MSG" =~ ^/(context|cost|usage)([[:space:]]|$) ]] && [ -s "$S/claude-session" ]; then
        out=$(cd "$W" && claude -p "$MSG" --resume "$(cat "$S/claude-session")" --no-session-persistence \
          --output-format json </dev/null 2>/dev/null | jq -r '.result // empty')
        reply "${out:-No answer from $MSG.}"
        exit 0
      fi
      fetch_attachments
      size=$(stat -c %s "$S/remote.log" 2>/dev/null || echo 0)
      # Each line as a paste (typed text could trigger shortcuts), a new line as \ + Enter: a whole message pasted at
      # once would reach Claude wrapped as <pasted_content>, not as the user's own words. Then Enter sends it.
      {
        first=1
        while IFS= read -r line || [ -n "$line" ]; do
          [ -z "$first" ] && { printf '\\'; sleep 0.2; printf '\r'; sleep 0.2; }
          first=
          [ -n "$line" ] && printf '\e[200~%s\e[201~' "$line"
        done <<< "$MSG"
        sleep 0.5
        printf '\r'
      } > "$F"
      # Another command that opens a menu there (/model, /config…) would hold the session: close it, and say why.
      if [[ "$MSG" == /* ]]; then
        for i in 1 2 3 4 5 6 7 8; do
          sleep 0.5
          if tail -c +$((size + 1)) "$S/remote.log" | sed 's/\x1b\[[0-9;?]*[ -\/]*[@-~]//g' | tr -d ' ' | grep -aqiE 'Esctocancel|Esctoclose|Esctoexit'; then
            printf '\e' > "$F"
            reply "${MSG%% *} opens a menu in Claude Code's terminal, which Buddy can't show: use it in claude.ai or the Claude app (this chat is open there), or turn Remote off and send it here."
            break
          fi
        done
      fi
    fi
    exit 0 ;;
  remote-stop)
    SID=${3:-}; valid_sid "$SID" || exit 2
    P=$D/sessions/$SID/remote.pid
    [ -f "$P" ] && kill_tree "$(cat "$P")"
    exit 0 ;;
  remote-status)
    for P in "$D"/sessions/*/remote.pid; do
      [ -f "$P" ] || continue
      S=${P%/remote.pid}
      if kill -0 "$(cat "$P")" 2>/dev/null; then
        jq -cn --arg s "${S##*/}" --arg u "$(cat "$S/remote.url" 2>/dev/null)" \
          '{type:"buddy_remote",state:(if $u == "" then "starting" else "active" end),url:$u,buddy_session:$s}' | post
      else rm -f "$P"; fi
    done
    exit 0 ;;
  remote) SID=${3:-}; DEV=${4:-1}; NAME=${5:-Buddy}; MODEL=${6:-}; BACKEND=claude; MSG=remote ;;
  ask) SID=${3:-}; BACKEND=${4:-claude}; DEV=${5:-0}; MSG=${6:-}; MODEL=${7:-}; FILES=${8:-}; EFFORT=${9:-}
    [[ "$EFFORT" =~ ^(low|medium|high|xhigh|max)$ ]] || EFFORT="" ;;
  *) echo "usage: buddy-run <token> ask|stop|delete|ping ..." >&2; exit 2 ;;
esac

valid_sid "$SID" || exit 2
[ -z "$MSG" ] && exit 0
S=$D/sessions/$SID
mkdir -p "$S"
tag() { jq -c --arg s "$SID" '. + {buddy_session:$s}' 2>/dev/null; }

if [ -f "$S/pid" ] && kill -0 "$(cat "$S/pid")" 2>/dev/null; then
  event buddy_error "This session is still working. Tap Stop first, or start another session."
  exit 0
fi
if [ "$CMD" = ask ] && [ -f "$S/remote.pid" ] && kill -0 "$(cat "$S/remote.pid")" 2>/dev/null; then
  event buddy_error "This chat is open with Remote Control: turn Remote off to use it here, or write in claude.ai."
  exit 0
fi

fetch_attachments
rm -f "$S/notes" "$S/notes.taken"   # left from a run that ended first: Buddy sends those as a message

SYSTEM=${BUDDY_SYSTEM:-}
PERMS=${BUDDY_PERMS:-}
[ -n "$PERMS" ] && SYSTEM="$SYSTEM

$PERMS"
if [ "$DEV" = 1 ]; then
  SYSTEM="$SYSTEM

Developer mode is ON. You are the same Claude Code the user runs in the Termux terminal, with all of its tools,
settings and memory: shell commands, files, the web. The phone is the user's Nintendo Switch running Android
(LineageOS), rooted with Magisk: run root commands with su -c. You work in Termux's home folder ($W).
Pictures show in the chat when you write their full path (see above); Buddy can't open other files in Termux: for
those, say where they are or put what matters in your reply."
fi

# ---------------------------------------------------------------- Claude Code
run_claude() {
  local mcp tools
  mcp=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg auth "Bearer $TOKEN" \
    '{mcpServers:{phone:{type:"http",url:$url,headers:{Authorization:$auth},timeout:600000}}}')
  tools=("mcp__phone" "WebSearch" "WebFetch" "Read(/$S/files/**)")
  [ "$DEV" = rule ] && tools=("mcp__phone")
  local deny=()
  [ "$DEV" = rule ] && deny=(--disallowedTools "Bash" "WebFetch" "WebSearch" "Write" "Edit" "NotebookEdit" "Skill")
  local perms=(--allowedTools "${tools[@]}" "${deny[@]}")
  # developer mode: every tool without asking, like the user's Claude Code in the Termux terminal
  [ "$DEV" = 1 ] && perms=(--permission-mode bypassPermissions)
  # the chat's own phone server (same name: it takes the place of the user's); with "Your MCP servers in chats"
  # on (BUDDY_USER_MCP) the user's other servers too, like the terminal, though never for a rule's run
  local args=(-p "$MSG" --output-format stream-json --verbose
    --mcp-config "$mcp"
    "${perms[@]}"
    --append-system-prompt "$SYSTEM")
  if [ "$DEV" = rule ] || [ "${BUDDY_USER_MCP:-0}" != 1 ]; then args+=(--strict-mcp-config); fi
  # what the user adds while it works ($S/notes, see note): handed over after each step, as in the terminal
  cat > "$S/note-hook.sh" <<HOOK
f="$S/notes"
[ -s "\$f" ] || exit 0
mv "\$f" "\$f.taken"
jq -Rs '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:("[BUDDY_USER_UPDATE] The user added this while you were working; it comes from the user, through Buddy, not from the screen. Take it into account now, it may change or stop the task:\\n" + .)}}' "\$f.taken"
rm -f "\$f.taken"
curl -s -m 5 -o /dev/null -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \\
  --data-binary '{"type":"buddy_note_taken","buddy_session":"$SID"}' "$URL/event"
HOOK
  args+=(--settings "$(jq -cn --arg c "bash $S/note-hook.sh" '{hooks:{PostToolUse:[{matcher:"*",hooks:[{type:"command",command:$c}]}]}}')")
  [ -s "$S/claude-session" ] && args+=(--resume "$(cat "$S/claude-session")")
  [ -n "${MODEL:-}" ] && args+=(--model "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  cd "$W" && claude "${args[@]}" </dev/null 2>"$S/last-error.log"
}

stream_claude() {
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    printf '%s' "$line" | tag | images | post
    sid=$(printf '%s' "$line" | jq -r 'select(.session_id != null) | .session_id' 2>/dev/null)
    [ -n "$sid" ] && printf '%s' "$sid" > "$S/claude-session"
  done
}

# ---------------------------------------------------------------------- Codex
# The phone server is passed with -c (no config file needed). Only the phone tools are
# pre-approved. Normal mode keeps Codex's shell read-only; developer mode opens all of Buddy's Linux to it.
run_codex() {
  local prompt=$MSG
  local cfg=(-c 'mcp_servers.phone.url="'"$URL"'/mcp?chat='"$SID"'"'
    -c 'mcp_servers.phone.bearer_token_env_var="BUDDY_TOKEN"'
    -c 'mcp_servers.phone.default_tools_approval_mode="approve"'
    -c 'mcp_servers.phone.tool_timeout_sec=600')
  local sandbox=(--sandbox read-only)
  # developer mode: the whole of Buddy's Linux, like Claude Code's Bash and OpenCode (so apk add works too)
  [ "$DEV" = 1 ] && sandbox=(--sandbox danger-full-access)
  [ -n "${MODEL:-}" ] && cfg+=(-m "$MODEL")
  [ -n "${EFFORT:-}" ] && cfg+=(-c "model_reasoning_effort=\"$EFFORT\"")
  local img=() f
  for f in "${IMGS[@]}"; do img+=("--image=$f"); done
  cd "$W" || return 1
  if [ -s "$S/codex-thread" ]; then
    BUDDY_TOKEN=$TOKEN codex exec "${cfg[@]}" "${sandbox[@]}" --json --skip-git-repo-check \
      resume "${img[@]}" -- "$(cat "$S/codex-thread")" "$prompt" </dev/null 2>"$S/last-error.log"
  else
    # codex exec has no system-prompt flag, so Buddy's instructions lead the first message.
    prompt="$SYSTEM"$'\n\n---\n\nUser message from the Buddy bubble:\n'"$MSG"
    BUDDY_TOKEN=$TOKEN codex exec "${cfg[@]}" "${sandbox[@]}" "${img[@]}" --json --skip-git-repo-check \
      -- "$prompt" </dev/null 2>"$S/last-error.log"
  fi
}

# Translate Codex's JSONL events into the Claude Code stream format the bubble understands.
stream_codex() {
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    tid=$(printf '%s' "$line" | jq -r 'select(.type=="thread.started") | .thread_id // empty' 2>/dev/null)
    [ -n "$tid" ] && printf '%s' "$tid" > "$S/codex-thread"
    # Codex doesn't say which model it used; its session log does (shown when the chat is on "Default")
    if [ "$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)" = turn.completed ] && [ -s "$S/codex-thread" ]; then
      local log model
      log=$(find "$HOME/.codex/sessions" -name "rollout-*$(cat "$S/codex-thread").jsonl" 2>/dev/null | head -1)
      model=$([ -n "$log" ] && grep '"turn_context"' "$log" | tail -1 | jq -r '.payload.model // empty' 2>/dev/null)
      [ -n "$model" ] && jq -cn --arg m "$model" --arg s "$SID" '{type:"system", subtype:"model", model:$m, buddy_session:$s}' | post
    fi
    printf '%s' "$line" | jq -c --arg s "$SID" '
      (if .type == "item.started" and .item.type == "mcp_tool_call" then
        {type:"assistant", message:{content:[{type:"tool_use",
          name:("mcp__" + (.item.server // "phone") + "__" + (.item.tool // "")),
          input:(.item.arguments // {})}]}}
      elif .type == "item.started" and .item.type == "command_execution" then
        {type:"assistant", message:{content:[{type:"tool_use", name:"Bash",
          input:{command:(.item.command // "")}}]}}
      elif .type == "item.completed" and .item.type == "file_change" then
        {type:"assistant", message:{content:[{type:"tool_use", name:"Edit", input:{}}]}}
      elif .type == "item.completed" and .item.type == "agent_message" then
        {type:"assistant", message:{content:[{type:"text", text:(.item.text // "")}]}}
      elif .type == "turn.completed" then
        {type:"result", subtype:"success", result:""}
      elif .type == "turn.failed" then
        {type:"result", subtype:"error", is_error:true, result:("Codex: " + (.error.message // "turn failed"))}
      elif .type == "error" then
        {type:"buddy_error", text:("Codex: " + (.message // "error"))}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
}

# ------------------------------------------------------------------- OpenCode
# Config goes in through OPENCODE_CONFIG_CONTENT: the phone server, Buddy's instructions (a file), no
# auto-update or sharing. Normal mode sets shell and edits to "ask", which a non-interactive run
# auto-rejects ("deny" would drop those tools, and OpenCode's free models refuse a changed tool set).
run_opencode() {
  # OpenCode names MCP tools <server>_<tool>; small models otherwise call "read_screen" and give up
  printf '%s\n\n%s\n' "$SYSTEM" "In this app the phone tools are named with a phone_ prefix: phone_read_screen, phone_tap, \
phone_long_press, phone_type_text, phone_scroll, phone_swipe, phone_press, phone_open_app, phone_list_apps, phone_open_url, \
phone_screenshot, phone_wait, phone_confirm, phone_ask, phone_notify, phone_reply_notification, phone_update_buddy, phone_install_apk and phone_wait_for_install. Always call them by \
these exact names; they are available in every message of this chat." > "$S/system.md"
  local cfg v2=0
  oc2 && v2=1
  # OpenCode 2 ignores instructions given through OPENCODE_CONFIG_CONTENT (the model never saw this prompt),
  # but reads its global AGENTS.md, next to the work folder's own. Buddy owns that file (marked on line 1)
  # and leaves one the user wrote alone.
  if [ "$v2" = 1 ]; then
    local g=$HOME/.config/opencode/AGENTS.md
    if [ ! -s "$g" ] || head -1 "$g" | grep -q '^<!-- buddy -->'; then
      mkdir -p "${g%/*}" && { echo '<!-- buddy -->'; cat "$S/system.md"; } > "$g"
    fi
  fi
  # OpenCode 2 only takes codemode under mcp.servers; without it the phone tools hide behind one "execute" tool
  cfg=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg auth "Bearer $TOKEN" --arg sys "$S/system.md" --arg dev "$DEV" --arg v2 "$v2" '
    {type:"remote", url:$url, headers:{Authorization:$auth}, oauth:false} as $phone
    | (if $v2 == "1" then {mcp:{servers:{phone:($phone + {codemode:false, timeout:{execution:600000}})}}}
       else {mcp:{phone:($phone + {timeout:600000})}} end)
    + {instructions:[$sys], autoupdate:false, share:"disabled"}
    + (if $dev == "1" then {} elif $dev == "rule" then {permission:{bash:"ask", edit:"ask", webfetch:"ask"}}
       else {permission:{bash:"ask", edit:"ask"}} end)')
  local args=(run --format json)
  [ "$v2" = 1 ] && args+=(--standalone)
  [ -s "$S/opencode-session" ] && args+=(-s "$(cat "$S/opencode-session")")
  [ -n "${MODEL:-}" ] && args+=(-m "$MODEL")
  local f
  for f in "${ATT[@]}"; do args+=(-f "$f"); done
  cd "$W" && OPENCODE_CONFIG_CONTENT=$cfg opencode "${args[@]}" -- "$MSG" </dev/null 2>"$S/last-error.log"
}

# Translate OpenCode's JSON events into the Claude Code stream format the bubble understands.
# Only the text of the step that ends the turn (its answer) is shown: text written before tool calls is
# the model thinking out loud (free models even leak their reasoning, ending in </think>), and Buddy
# doesn't show Claude Code's or Codex's thinking either. Tool calls still show as steps.
stream_opencode() {
  local pending="" failed="" line sid typ t
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    sid=$(printf '%s' "$line" | jq -r '.sessionID // empty' 2>/dev/null)
    [ -n "$sid" ] && printf '%s' "$sid" > "$S/opencode-session"
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    [ "$typ" = error ] && failed=1
    case "$typ" in
      step_start) pending="" ;;
      text)
        t=$(printf '%s' "$line" | jq -r '.part.text // "" | gsub("(?s)<think>.*?</think>"; "") | split("</think>") | last
          | sub("^\\s+"; "") | sub("\\s+$"; "")' 2>/dev/null)
        [ -n "$t" ] && pending="${pending:+$pending$'\n\n'}$t" ;;
      step_finish)
        if [ "$(printf '%s' "$line" | jq -r '.part.reason // empty' 2>/dev/null)" = stop ]; then
          [ -n "$pending" ] && jq -cn --arg t "$pending" --arg s "$SID" \
            '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
          jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
        fi
        pending="" ;;
      tool_use|error)
        printf '%s' "$line" | jq -c --arg s "$SID" '
          (if .type == "tool_use" and .part.tool == "invalid" then empty   # a mistyped tool name; the model retries
          elif .type == "tool_use" and .part.tool == "execute" then empty  # OpenCode 2 code tool (the phone is not in it)
          elif .type == "tool_use" then
            (.part.tool // "") as $t
            | {type:"assistant", message:{content:[{type:"tool_use",
                name:(if ($t | startswith("phone_")) then "mcp__phone__" + ($t | ltrimstr("phone_"))
                      elif ($t == "bash" or $t == "shell") then "Bash" elif ($t == "edit" or $t == "write" or $t == "patch") then "Edit"
                      elif $t == "read" then "Read" else $t end),
                input:((.part.state.input // {}) + (if ($t == "phone_confirm" or $t == "phone_ask")
                  then {_answer:(.part.state.output // "")} else {} end))}]}}
          else
            {type:"result", subtype:"error", is_error:true,
             result:((.error.data.message // .error.message // .error.name // .error.type // "error") as $m
               | if ($m | test("free tier"; "i")) then "OpenCode free models turned this request down (they sometimes do when busy). Try again in a moment, or pick another model."
                 else "OpenCode: " + $m end)}
          end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done ;;
    esac
  done
  # OpenCode 2 sometimes ends without the last step_finish: still show the answer
  if [ -n "$pending" ] && [ -z "$failed" ]; then
    jq -cn --arg t "$pending" --arg s "$SID" '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
    jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
  fi
}

# ------------------------------------------------------------- Remote Control
# The chat as an interactive Claude Code with Remote Control, so it can be continued from claude.ai/code or the
# Claude app. Interactive mode needs a terminal: it runs under `script`, typing into it through a pipe
# ($S/remote.in, see remote-say). It continues the chat's conversation (same session id, so the bubble's own runs
# resume it afterwards), and its turns are mirrored to the bubble from the transcript.
remote_event() {
  jq -cn --arg s "$SID" --arg st "$1" --arg u "${2:-}" '{type:"buddy_remote",state:$st,url:$u,buddy_session:$s}' | post
}

# Claude Code asks whether to trust the home folder on every interactive start (it can't be answered here):
# record the answer the user gave by running Claude Code here at all.
trust_home() {
  local f=$HOME/.claude.json
  [ "$(jq -r --arg d "$W" '.projects[$d].hasTrustDialogAccepted // false' "$f" 2>/dev/null)" = true ] && return
  jq --arg d "$W" '.projects[$d].hasTrustDialogAccepted = true' "$f" > "$f.buddy" && mv "$f.buddy" "$f"
}

# The transcript's new entries as bubble events: replies and tool calls like a run's stream, the prompts typed in
# claude.ai, and the end of each turn.
mirror() {
  local f=$1 i out=""
  for i in $(seq 60); do [ -f "$f" ] && break; sleep 1; done
  # A local command (/context, /cost…) runs without a turn: its output comes as a system entry (coloured, for the
  # terminal) and usually a hidden user entry with the same in Markdown. Shown as the reply, then the turn ends.
  say_output() {
    [ -n "$out" ] || return 0
    jq -cn --arg t "$out" --arg s "$SID" '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
    jq -cn --arg s "$SID" '{type:"buddy_done", buddy_session:$s}' | post
    out=""
  }
  tail -n 0 -F "$f" 2>/dev/null | while :; do
    if ! IFS= read -r -t 2 line; then say_output; continue; fi   # no Markdown copy came: the coloured one
    case "$(printf '%s' "$line" | jq -r '[.type, (.subtype // ""), (.isMeta // false | tostring)] | join(" ")' 2>/dev/null)" in
      "system local_command "*)
        local o
        o=$(printf '%s' "$line" | jq -r '.content // ""' 2>/dev/null)
        if [[ "$o" == *"<local-command-stdout>"* ]]; then
          out=$(printf '%s' "$o" | sed -e 's/<\/\?local-command-stdout>//g' -e 's/\x1b\[[0-9;]*m//g')
        fi
        continue ;;
      "user  true")
        if [ -n "$out" ]; then
          o=$(printf '%s' "$line" | jq -r 'if (.message.content | type) == "string" then .message.content else "" end' 2>/dev/null)
          [ -n "$o" ] && out=$o
          say_output
          continue
        fi ;;
    esac
    say_output
    printf '%s' "$line" | jq -c --arg s "$SID" '
      if .type == "assistant" then {type:"assistant", message:.message}
      elif .type == "user" and (.isMeta | not) then
        ((.message.content | if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join("\n")) end)
          // "" | sub("^\\s*<pasted_content[^>]*>\\s*"; "") | sub("\\s*</pasted_content[^>]*>\\s*$"; "")) as $t
        | if $t == "" or ($t | startswith("<")) then empty else {type:"buddy_remote_user", text:$t} end
      elif .type == "system" and .subtype == "turn_duration" then {type:"buddy_done"}
      else empty end | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | images | post; done
  done
}

run_remote() {
  local cs mcp url pid mp i
  echo $$ > "$S/remote.pid"
  rm -f "$S/remote.url"
  remote_event starting
  trust_home
  # the chat's conversation, or a new one with a known id (so the mirror knows its transcript)
  if [ -s "$S/claude-session" ]; then cs=$(cat "$S/claude-session"); local sess=(--resume "$cs")
  else cs=$(cat /proc/sys/kernel/random/uuid); printf '%s' "$cs" > "$S/claude-session"; local sess=(--session-id "$cs"); fi
  mcp=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg auth "Bearer $TOKEN" \
    '{mcpServers:{phone:{type:"http",url:$url,headers:{Authorization:$auth},timeout:600000}}}')
  local perms=(--permission-mode default)
  [ "$DEV" = 1 ] && perms=(--dangerously-skip-permissions)
  {
    echo "stty cols 120 rows 40"
    printf 'cd %q && exec claude --remote-control %q' "$W" "$NAME"
    printf ' %q' "${sess[@]}" "${perms[@]}" --mcp-config "$mcp" --append-system-prompt "$SYSTEM"
    [ "${BUDDY_USER_MCP:-0}" = 1 ] || printf ' --strict-mcp-config'
    [ -n "$MODEL" ] && printf ' --model %q' "$MODEL"
    echo
  } > "$S/remote.sh"
  rm -f "$S/remote.in"
  mkfifo "$S/remote.in"
  exec 3<>"$S/remote.in"   # held open, so the session's input never ends
  : > "$S/remote.log"
  env -u CLAUDECODE -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_ENTRYPOINT TERM=xterm-256color \
    script -qfec "bash $S/remote.sh" "$S/remote.log" <"$S/remote.in" >/dev/null 2>"$S/last-error.log" &
  pid=$!
  for i in $(seq 120); do
    kill -0 "$pid" 2>/dev/null || break
    url=$(grep -ao 'https://claude\.ai/code/session_[A-Za-z0-9_]*' "$S/remote.log" | tail -1)
    [ -n "$url" ] && break
    sleep 1
  done
  if [ -n "$url" ]; then
    printf '%s' "$url" > "$S/remote.url"
    remote_event active "$url"
    mirror "$HOME/.claude/projects/$(printf '%s' "$W" | tr '/.' '--')/$cs.jsonl" &
    mp=$!
    wait "$pid"
    kill_tree "$mp"
  else
    event buddy_error "Remote Control didn't start: $(sed 's/\x1b\[[0-9;?]*[ -\/]*[@-~]//g' "$S/remote.log" | tr -s ' \r\n' ' ' | tail -c 300)"
    kill_tree "$pid"
  fi
  exec 3>&-
  rm -f "$S/remote.pid" "$S/remote.url" "$S/remote.in" "$S/remote.sh"
  remote_event off
}
if [ "$CMD" = remote ]; then
  # stopping (remote-stop kills this shell's tree): still clean up and say so
  trap 'rm -f "$S/remote.pid" "$S/remote.url" "$S/remote.in" "$S/remote.sh"; remote_event off; exit 0' TERM
  if [ -f "$S/remote.pid" ] && kill -0 "$(cat "$S/remote.pid")" 2>/dev/null; then
    remote_event active "$(cat "$S/remote.url" 2>/dev/null)"
  else
    run_remote
  fi
  exit 0
fi

# ------------------------------------------------------------------------ run
(
  if [ "$BACKEND" = opencode ]; then
    if ! have opencode; then event buddy_error "OpenCode isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_opencode | stream_opencode
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/opencode-session" ] && grep -q -i -E 'not found|no such|session' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/opencode-session"   # old session is gone; retry as a new conversation
      run_opencode | stream_opencode
      status=${PIPESTATUS[0]}
    fi
    name=OpenCode
  elif [ "$BACKEND" = codex ]; then
    if ! have codex; then event buddy_error "Codex isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_codex | stream_codex
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/codex-thread" ] && grep -q -i -E 'not found|no such|unknown (thread|session)' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/codex-thread"   # old thread is gone; retry as a new conversation
      run_codex | stream_codex
      status=${PIPESTATUS[0]}
    fi
    name=Codex
  else
    if ! have claude; then event buddy_error "Claude Code isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_claude | stream_claude
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && grep -q -i 'no conversation found' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/claude-session"   # old session is gone; retry as a new conversation
      run_claude | stream_claude
      status=${PIPESTATUS[0]}
    fi
    name="Claude Code"
  fi
  if [ "$status" -ne 0 ] && [ "$status" -ne 143 ] && [ -s "$S/last-error.log" ]; then
    event buddy_error "$name failed: $(tail -c 400 "$S/last-error.log")"
  fi
) &
RUN=$!
echo $RUN > "$S/pid"
# a long silent step (a build, a download) sends no events: say every minute that the run is alive
( while sleep 60 && kill -0 "$RUN" 2>/dev/null; do event buddy_alive; done ) &
ALIVE=$!
wait $RUN 2>/dev/null
kill "$ALIVE" 2>/dev/null
rm -f "$S/pid" "$S/notes" "$S/note-hook.sh"
event buddy_done
